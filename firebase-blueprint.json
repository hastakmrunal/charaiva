{
  "entities": {
    "UserProfileDoc": {
      "title": "UserProfileDoc",
      "description": "Private explorer profile storing user identity, preferred language, and traveler style.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Explorer display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Explorer email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "preferredLanguage": {
          "type": "string",
          "description": "Two-letter language code from supported languages.",
          "minLength": 2,
          "maxLength": 16
        },
        "travelerType": {
          "type": "string",
          "enum": [
            "heritage_enthusiast",
            "foodie",
            "nature_explorer",
            "casual_tourist",
            "photographer"
          ],
          "description": "Primary traveler persona used to tailor narration topics."
        },
        "visitedCount": {
          "type": "integer",
          "description": "Total number of visited sights."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest profile update."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "preferredLanguage",
        "travelerType",
        "createdAt",
        "updatedAt"
      ]
    },
    "GuidePreferencesDoc": {
      "title": "GuidePreferencesDoc",
      "description": "Persistent app preferences synced directly with Charaiva Settings and onboarding state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "outputMode": {
          "type": "string",
          "enum": ["speech", "text", "both"],
          "description": "Preferred guide output modality."
        },
        "voiceGender": {
          "type": "string",
          "enum": ["female", "male"],
          "description": "Preferred narration voice gender."
        },
        "persona": {
          "type": "string",
          "enum": ["warm_female", "scholarly", "adventurous", "concise"],
          "description": "Guide storytelling persona."
        },
        "voicePitch": {
          "type": "number",
          "description": "Speech synthesis pitch multiplier."
        },
        "speechRate": {
          "type": "number",
          "description": "Speech synthesis speed multiplier."
        },
        "savePhotosToDeviceMemory": {
          "type": "boolean",
          "description": "Whether captured sight photos are stored in local device IndexedDB."
        },
        "locationMode": {
          "type": "string",
          "enum": ["gps", "manual"],
          "description": "Automatic GPS vs manual city destination mode."
        },
        "manualCityName": {
          "type": "string",
          "maxLength": 100,
          "description": "Selected manual city name."
        },
        "manualStateName": {
          "type": "string",
          "maxLength": 100,
          "description": "Selected manual state or region."
        },
        "manualCountryName": {
          "type": "string",
          "maxLength": 100,
          "description": "Selected manual country."
        },
        "manualLatitude": {
          "type": "number",
          "description": "Latitude for selected manual city."
        },
        "manualLongitude": {
          "type": "number",
          "description": "Longitude for selected manual city."
        },
        "theme": {
          "type": "string",
          "enum": ["celestial", "sunset", "emerald", "daylight"],
          "description": "Active color atmosphere preset."
        },
        "topics": {
          "type": "object",
          "description": "Map of 10 boolean narration topic preferences."
        },
        "hasSeenIntro": {
          "type": "boolean",
          "description": "Whether the user has viewed or skipped the App Introduction page."
        },
        "hasCompletedTour": {
          "type": "boolean",
          "description": "Whether the user has finished or skipped the Screen-by-Screen Tour."
        },
        "hasCompletedLoginSetup": {
          "type": "boolean",
          "description": "Whether initial profile and preference setup is complete."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest preference update."
        }
      },
      "required": [
        "uid",
        "outputMode",
        "voiceGender",
        "persona",
        "voicePitch",
        "speechRate",
        "savePhotosToDeviceMemory",
        "locationMode",
        "theme",
        "topics",
        "hasSeenIntro",
        "hasCompletedTour",
        "hasCompletedLoginSetup",
        "updatedAt"
      ]
    },
    "TravelJournalEntryDoc": {
      "title": "TravelJournalEntryDoc",
      "description": "Owner-isolated persistent travel journal log entry recording verified visits, user notes, and AI tour guide summaries.",
      "type": "object",
      "properties": {
        "journalId": {
          "type": "string",
          "description": "Unique journal entry document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the journal owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "placeId": {
          "type": "string",
          "description": "Verified place identifier when available.",
          "maxLength": 160
        },
        "placeName": {
          "type": "string",
          "description": "Name of the landmark or destination visited.",
          "minLength": 1,
          "maxLength": 160
        },
        "city": {
          "type": "string",
          "description": "City where the destination is located.",
          "maxLength": 100
        },
        "country": {
          "type": "string",
          "description": "Country where the destination is located.",
          "maxLength": 100
        },
        "locationName": {
          "type": "string",
          "description": "Formatted location label.",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": [
            "monument",
            "temple",
            "fort",
            "museum",
            "landscape",
            "food",
            "plant",
            "object",
            "building",
            "animal"
          ],
          "description": "Landmark category classification."
        },
        "visitDate": {
          "type": "string",
          "description": "Visit date in YYYY-MM-DD format.",
          "minLength": 8,
          "maxLength": 20,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "description": "Traveler personal notes about their visit.",
          "maxLength": 2000
        },
        "guideSummary": {
          "type": "string",
          "description": "Summary generated by Charaiva AI Guide.",
          "maxLength": 1500
        },
        "narration": {
          "type": "string",
          "description": "Tour guide audio script associated with the sight.",
          "maxLength": 6000
        },
        "keyFacts": {
          "type": "array",
          "description": "Key historical or architectural facts for the destination."
        },
        "tags": {
          "type": "array",
          "description": "Topical tags describing the entry."
        },
        "language": {
          "type": "string",
          "description": "Language of the saved tour guide script.",
          "maxLength": 60
        },
        "imageUrl": {
          "type": "string",
          "description": "Safe external or local asset URL (no raw base64 blobs).",
          "maxLength": 600
        },
        "visitedConfirmed": {
          "type": "boolean",
          "description": "True when the traveler confirmed or checked into the visit."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the journal entry was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest update."
        }
      },
      "required": [
        "journalId",
        "userId",
        "placeId",
        "placeName",
        "city",
        "country",
        "locationName",
        "category",
        "visitDate",
        "notes",
        "guideSummary",
        "visitedConfirmed",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/profile": {
      "schema": { "$ref": "#/entities/UserProfileDoc" },
      "description": "Owner-isolated explorer PII and profile document."
    },
    "/users/{userId}/preferences/guide": {
      "schema": { "$ref": "#/entities/GuidePreferencesDoc" },
      "description": "Owner-isolated Charaiva settings and onboarding state document."
    },
    "/users/{userId}/journalEntries/{journalId}": {
      "schema": { "$ref": "#/entities/TravelJournalEntryDoc" },
      "description": "Owner-isolated private travel journal entries synced per authenticated user UID."
    }
  }
}
